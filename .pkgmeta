package-as: Reorder_Talent_Loadouts
enable-nolib-creation: no
manual-changelog: CHANGELOG.md

# Ship only .lua + .toc + CHANGELOG.md + LICENSE + logo.tga. Every other
# tracked file must be listed below.
ignore:
    - README.md
    - preview.gif
    - .pkgmeta
    - .gitignore
    - .gitattributes
    - .github
    # backup: gitignored and untracked, never packaged either way
    - AGENTS.md
    - AGENTS_MEMORY.md
    - tests
