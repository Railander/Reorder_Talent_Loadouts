source/
.codegraph/

# secrets / credentials (explicit even though the deny-by-default below covers them)
CF_API_KEY.txt
*.key
*.pem
*.pfx
.env
.env.*
*token*
secret*

# EXCLUSIONARY BY DEFAULT (house rule -- see ../AGENTS.md): everything is
# ignored unless explicitly allowed below. A new file that isn't allowlisted
# stays invisible to `git status`. No packager runs from this local dev repo
# (releases run from the public repo), so dev files are tracked intentionally
# -- but they are still explicitly listed below, never swept in by a wildcard.
*
!*/

# explicitly allowed: game files, player docs, release infra
!.gitignore
!*.lua
!*.toc
!CHANGELOG.md
!README.md
!LICENSE
!preview.gif

# NOT allowlisted: agent docs and suites stay ignored by default even in this
# local dev repo (already-tracked copies are immune to ignore rules;
# brand-new dev files need an explicit `!` line or `git add -f`). Public
# clones must never track these -- see ../AGENTS.md.
AGENTS.md
AGENTS_MEMORY.md
tests/
